{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.9.0"
      }
  },
  "routes": [
    { "src": "/docs/(.*)", "dest": "/docs/$1" },
    { "src": "/(js|css|icons|models)/(.*)", "dest": "/$1/$2" },
    { "src": "/(.*\\.php)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
