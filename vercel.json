{
  "functions": {
    "api/**/*.php": { "runtime": "vercel-php@0.7.0" },
    "*.php": { "runtime": "vercel-php@0.7.0" },
    "aldi/**/*.php": { "runtime": "vercel-php@0.7.0" },
    "desta/**/*.php": { "runtime": "vercel-php@0.7.0" },
    "dwi/**/*.php": { "runtime": "vercel-php@0.7.0" },
    "fiis/**/*.php": { "runtime": "vercel-php@0.7.0" },
    "hasbi/**/*.php": { "runtime": "vercel-php@0.7.0" },
    "veve/**/*.php": { "runtime": "vercel-php@0.7.0" }
  },
  "routes": [
    { "src": "/docs/(.*)", "dest": "/docs/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
